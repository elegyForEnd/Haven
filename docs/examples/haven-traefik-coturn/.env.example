# Domain
DOMAIN=haven.example.com

# Let's Encrypt email
ACME_EMAIL=admin@example.com

# Haven
SERVER_NAME=your-server-name
ADMIN_USERNAME=admin

# TURN shared secret (generate with: openssl rand -hex 32)
TURN_SECRET=change-me

# Optional EasyTier shared node, enabled with the easytier Compose profile.
# Use a publicly reachable DNS name or IPv4 for the host.
# HAVEN_EASYTIER_HOST=haven.example.com
# HAVEN_EASYTIER_PORT=11010
# Generate independent values using openssl rand -hex 32 for each secret
# and openssl rand -hex 8 for the prefix.
# HAVEN_EASYTIER_SECRET=
# HAVEN_EASYTIER_COORDINATOR_SECRET=
# HAVEN_EASYTIER_NETWORK_PREFIX=
